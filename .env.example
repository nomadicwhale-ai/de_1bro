# Copy to .env (`cp .env.example .env`) and adjust. .env is git-ignored.
# Real environment variables override this file. ${VAR} and ${VAR:-default} expansion works.

# ---------------------------------------------------------------- reproducibility
# Master seed for the deterministic generator. Decimal or 0x-hex. Changing it changes ALL data
# and invalidates spec/golden.json; leave the default for published results.
BENCH_SEED=0x5EED1B20

# ---------------------------------------------------------------- paths
DATA_DIR=./data             # generated datasets (git-ignored, can be huge)
RESULTS_DIR=./results       # raw/ and summary.* benchmark output
REPORT_DIR=./report

# ---------------------------------------------------------------- data generation
CHUNK_ROWS=1000000          # rows per chunk file / streaming chunk
GEN_WORKERS=4               # parallel chunk workers for `make gen`
GEN_FORMATS=parquet,csv     # parquet,csv,arrow
PARQUET_COMPRESSION=zstd    # zstd | snappy | lz4 | gzip | none
PRICE_AS=decimal            # decimal (decimal(18,2)) | float64 | cents (int64)
GEN_CHECKSUM=full           # full | none  (none is faster, skips manifest digests)

# ---------------------------------------------------------------- resource budget (see config/budget.yaml)
MAX_DISK_GB=                # empty = use all free disk; the generator refuses to exceed it
MAX_RSS_GB=12               # per-benchmark-process memory cap
RUN_TIMEOUT_SEC=3600        # per-run wall-clock timeout
SINGLE_THREAD_CPU=0         # core id used with taskset for the single-thread track
PARALLEL_THREADS=4          # thread count for the parallel track

# ---------------------------------------------------------------- run protocol
WARMUP_RUNS=1
TIMED_RUNS=7                # <=100M rows
TIMED_RUNS_1B=3             # 1B rows
SHUFFLE_SEED=42             # order randomisation of implementations

# ---------------------------------------------------------------- database / engine connections (Track S)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bench
POSTGRES_USER=bench
POSTGRES_PASSWORD=change-me
POSTGRES_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

SPARK_MASTER=local[4]
SPARK_DRIVER_MEMORY=8g
SPARK_LOCAL_DIR=/tmp/spark

DUCKDB_THREADS=4
DUCKDB_MEMORY_LIMIT=8GB
DUCKDB_TEMP_DIR=/tmp/duckdb
