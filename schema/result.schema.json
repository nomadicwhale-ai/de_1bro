{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/de_1bro/result.schema.json",
  "title": "Benchmark result record (one JSON object per line)",
  "type": "object",
  "required": ["run_id", "track", "implementation", "variant", "op", "dataset", "rows", "mode",
               "threads", "status", "env"],
  "properties": {
    "run_id": {"type": "string"},
    "track": {"enum": ["L", "S"], "description": "L = programming language, S = data system"},
    "implementation": {"type": "string", "description": "e.g. rust, python, duckdb"},
    "variant": {"enum": ["stdlib", "tuned", "parallel", "ecosystem", "native", "default"]},
    "toolchain": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "flags": {"type": "string"}}
    },
    "op": {"type": "string", "pattern": "^OP[0-9]{2}$"},
    "dataset": {"enum": ["A", "B", "C", "D", "E", "ABC", "AB"]},
    "rows": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["materialized", "streaming"]},
    "chunk_rows": {"type": ["integer", "null"]},
    "threads": {"type": "integer", "minimum": 1},
    "status": {"enum": ["ok", "skipped", "failed", "timeout", "not_run", "n/a", "incorrect"]},
    "skip_reason": {"type": ["string", "null"]},
    "correct": {"type": ["boolean", "null"]},
    "checksum": {"type": ["string", "null"]},
    "expected_checksum": {"type": ["string", "null"]},
    "row_count": {"type": ["integer", "null"]},
    "startup_ms": {"type": ["number", "null"], "minimum": 0},
    "load_ms": {"type": ["number", "null"], "minimum": 0},
    "compute_ms": {"type": ["number", "null"], "minimum": 0},
    "total_ms": {"type": ["number", "null"], "minimum": 0},
    "runs": {"type": "array", "items": {"type": "number", "minimum": 0},
             "description": "compute_ms of each timed run"},
    "median_ms": {"type": ["number", "null"]},
    "min_ms": {"type": ["number", "null"]},
    "p95_ms": {"type": ["number", "null"]},
    "iqr_pct": {"type": ["number", "null"]},
    "noisy": {"type": ["boolean", "null"]},
    "rows_per_s": {"type": ["number", "null"]},
    "mb_per_s": {"type": ["number", "null"]},
    "peak_rss_mb": {"type": ["number", "null"]},
    "steady_rss_mb": {"type": ["number", "null"]},
    "chunk_rows_per_s": {"type": "array", "items": {"type": "number"},
                         "description": "streaming throughput per chunk (time series)"},
    "env": {
      "type": "object",
      "required": ["cpu", "cores", "ram_gb", "os"],
      "properties": {
        "cpu": {"type": "string"}, "cores": {"type": "integer"}, "ram_gb": {"type": "number"},
        "os": {"type": "string"}, "kernel": {"type": "string"},
        "container_limits": {"type": ["string", "null"]},
        "disk": {"type": ["string", "null"]}, "cache": {"enum": ["warm", "cold", "unknown"]},
        "governor": {"type": ["string", "null"]}
      }
    },
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "ok"}}},
     "then": {"required": ["correct", "checksum", "expected_checksum", "compute_ms", "runs",
                           "median_ms", "peak_rss_mb"]}},
    {"if": {"properties": {"status": {"enum": ["skipped", "not_run", "n/a"]}}},
     "then": {"required": ["skip_reason"]}}
  ],
  "additionalProperties": true
}
